      "chain": [
        "tape",
        "rs",
        "reverb"
      ],
      "params": {
        "tapeDrive": 16,
        "tapeWow": 0.3,
        "tapeFlutter": 0.3,
        "tapeNoise": 0.3,
        "tapeAge": 0.75,
        "rsRate": 12000,
        "rsBits": 10,
        "rsFilter": 3000,
        "rsMix": 0.4,
        "reverbSize": 0.5,
        "reverbDecay": 2.5,
        "reverbDamping": 0.85,
        "reverbMix": 0.25,
        "unstable": 0.25
      }
    },
    {
      "name": "Haunted Music Box",
      "description": "Shaky, warped playback with ghostly reversed fragments. Music boxes, bells, toy pianos.",
      "chain": [
        "trem",
        "tape",
        "rev",
        "reverb"
      ],
      "params": {
        "tremRate": 6,
        "tremDepth": 0.2,
        "tapeWow": 0.5,
        "tapeFlutter": 0.4,
        "tapeAge": 0.5,
        "tapeNoise": 0.15,
        "revSync": true,
        "revDivision": "1/4",
        "revMix": 0.25,
        "reverbSize": 0.7,
        "reverbDecay": 4,
        "reverbDamping": 0.6,
        "reverbMix": 0.4,
        "drift": 0.5
      }
    },
    {
      "name": "Void Pulse",
      "description": "Eighth-note square gating into dark echoes and a hall. Pads and held chords.",
      "chain": [
        "trem",
        "delay",
        "reverb"
      ],
      "params": {
        "tremSync": true,
        "tremDivision": "1/8",
        "tremShape": "Square",
        "tremDepth": 0.7,
        "tremStereo": 0.5,
        "delaySync": true,
        "delayDivision": "1/8 D",
        "delayFeedback": 0.5,
        "delayPingPong": true,
        "delayHighCut": 2500,
        "delayMix": 0.3,
        "reverbSize": 0.6,
        "reverbDecay": 3,
        "reverbDamping": 0.7,
        "reverbMix": 0.3
      }
    },
    {
      "name": "Night Drive 808",
      "description": "Harmonic warmth that helps 808s and bass cut through small speakers, without smearing the low end.",
      "chain": [
        "sat",
        "tape"
      ],
      "params": {
        "satMode": "Warm",
        "satDrive": 20,
        "satTone": -0.45,
        "satMix": 0.85,
        "tapeDrive": 10,
        "tapeWow": 0.02,
        "tapeFlutter": 0.03,
        "tapeNoise": 0.0,
        "tapeAge": 0.35,
        "outputGain": -3.5
      }
    }
